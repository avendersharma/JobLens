# Database
DATABASE_URL=postgres://user:password@localhost:5432/joblens

# Server
PORT=4001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4001

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
